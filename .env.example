# Copy to .env at this same repo root and adjust as needed.
# docker compose automatically reads .env from the directory it's run in.

# Postgres superuser (used only to create the per-service databases/users
# at first boot — see db-init/00-create-databases-and-users.sql)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_PORT=5432

# Real MDR-6 broker (per interface spec rev02 — broker runs on the MDR-6 itself)
MQTT_HOST=10.136.115.96
MQTT_PORT=8883
MQTT_USERNAME=ia_server
MQTT_PASSWORD=ia_server
# Set MQTT_INSECURE=false and MQTT_CAFILE_HOST=/path/to/ca.crt once a real
# cert is available; leave insecure=true for now (matches current bench setup).
MQTT_INSECURE=true
MQTT_CAFILE_HOST=
MQTT_CAFILE=

# tx2 (passenger counting) — runs on bare metal (GPU), reached via host
# networking from mqtt-service, so localhost works. No instance ID needed —
# mqtt-service discovers and syncs ALL of tx2's instances automatically,
# including ones created later.
TX2_URL=http://localhost:8000
